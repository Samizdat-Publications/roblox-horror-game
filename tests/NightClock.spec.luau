-- Core.NightClock and Core.Quota.
return function(t, Shared)
	local NightClock = require(Shared.Core.NightClock)
	local Quota = require(Shared.Core.Quota)
	local Config = require(Shared.Config)

	t.test("10 PM to 5 AM over realSeconds", function()
		local c = NightClock.new(Config)
		t.eq(NightClock.hour(Config, c), 22, "starts at 10 PM")
		t.eq(NightClock.label(NightClock.hour(Config, c)), "10:00 PM", "label")
		NightClock.step(c, Config.Night.realSeconds / 2)
		t.ok(math.abs(NightClock.hour(Config, c) - 25.5) < 1e-9, "1:30 AM at half")
		t.eq(NightClock.label(25.5), "1:30 AM", "after midnight")
		NightClock.step(c, Config.Night.realSeconds)
		t.ok(NightClock.done(c), "done")
		t.eq(NightClock.hour(Config, c), 29, "5 AM, never past it")
		t.eq(NightClock.timeLeft(c), 0, "no time left")
	end)

	t.test("secondsAt inverts hour, negative dt ignored", function()
		local c = NightClock.new(Config)
		t.ok(math.abs(NightClock.secondsAt(Config, c, 27) - Config.Night.realSeconds * 5 / 7) < 1e-9, "3 AM")
		NightClock.step(c, -5)
		t.eq(c.elapsed, 0, "no negative time")
	end)

	t.test("quota scales by crew and never drops below 1", function()
		t.eq(Quota.scaled(Config, 20, 4), math.floor(20 * Config.Scaling.quota[4] + 0.5), "crew 4")
		t.eq(Quota.scaled(Config, 20, 1), math.floor(20 * Config.Scaling.quota[1] + 0.5), "solo")
		t.eq(Quota.scaled(Config, 20, 9), Quota.scaled(Config, 20, 4), "clamped crew")
		t.eq(Quota.scaled(Config, 0.1, 1), 1, "at least 1")
	end)

	t.test("QuotaMet once, remove never below zero", function()
		local q = Quota.new(5)
		t.eq(#Quota.bank(q, 2, 3, 10), 0, "not yet")
		local e = Quota.bank(q, 1, 2, 20)
		t.eq(e[1].kind, "QuotaMet", "met")
		t.eq(q.metAt, 20, "when")
		t.eq(#Quota.bank(q, 1, 1, 30), 0, "not resent")
		Quota.remove(q, 9, 99)
		t.eq(q.banked, 0, "floored")
		t.eq(#Quota.bank(q, 3, 5, 40), 0, "not resent after a loss")
	end)
end
